# Clerk (required) — publishable key for the auth UI.
# Get it from https://dashboard.clerk.com → your app → API keys.
# Missing this key fails the app at boot, in every environment.
VITE_CLERK_PUBLISHABLE_KEY=

# Convex (required) — URL of the Convex deployment.
# Auto-populated by `pnpm convex:dev` on first run; do not leave blank.
# Missing this URL fails the app at boot, in every environment.
VITE_CONVEX_URL=
