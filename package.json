{
  "name": "rss-feed-v0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "husky && { git config --worktree --unset core.hooksPath 2>/dev/null || true; } && ./scripts/install-fallback-hook.sh",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "convex:dev": "convex-bundled dev",
    "convex:deploy": "convex-bundled deploy",
    "convex:codegen": "convex-bundled codegen",
    "intent:list": "intent list",
    "intent:validate": "intent validate",
    "intent:stale": "intent stale",
    "storybook": "STORYBOOK=true storybook dev -p 6006 --no-open",
    "build-storybook": "STORYBOOK=true storybook build"
  },
  "dependencies": {
    "@clerk/react": "6",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.0",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
